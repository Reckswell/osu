<!-- The score server builds against osu!'s published NuGet packages, not this repository's osu.Game, so it does not import
     the repository's Directory.Build.props (its analyzers and resources are for the game's projects). -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- ppy.osu.Game depends on an ImageSharp with advisories; the server decodes no images. -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <!-- The calculator version: the ppy.osu.Game and ppy.osu.Game.Rulesets.* packages osu!'s live score processor uses.
         scripts/ortho/server-update updates the file; the server rates every stored play again when it changes. -->
    <OsuCalculatorVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)calculator-version.txt').Trim())</OsuCalculatorVersion>
  </PropertyGroup>
</Project>
